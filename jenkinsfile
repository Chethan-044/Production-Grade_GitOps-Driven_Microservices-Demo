
pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        AWS_REGION = 'us-east-1'
        AWS_ACCOUNT_ID = '216482850616'

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_PREFIX = 'online-boutique'

        DOCKER_BUILDKIT = '1'

        HELM_VALUES = 'helm-chart/values.yaml'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Initialize') {
            steps {
                script {
                    env.IMAGE_TAG = sh(
                        script: 'git rev-parse --short=12 HEAD',
                        returnStdout: true
                    ).trim()

                    echo "Image tag: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('AWS Authentication') {
            steps {
                sh '''
                    aws sts get-caller-identity

                    aws ecr get-login-password \
                      --region "$AWS_REGION" | \
                      docker login \
                      --username AWS \
                      --password-stdin "$ECR_REGISTRY"
                '''
            }
        }

        stage('Create ECR Repositories') {
            steps {
                script {
                    def services = [
                        'adservice',
                        'cartservice',
                        'checkoutservice',
                        'currencyservice',
                        'emailservice',
                        'frontend',
                        'loadgenerator',
                        'paymentservice',
                        'productcatalogservice',
                        'recommendationservice',
                        'shippingservice'
                    ]

                    services.each { service ->
                        sh """
                            aws ecr describe-repositories \
                              --repository-names ${ECR_PREFIX}/${service} \
                              --region ${AWS_REGION} >/dev/null 2>&1 || \
                            aws ecr create-repository \
                              --repository-name ${ECR_PREFIX}/${service} \
                              --region ${AWS_REGION}
                        """
                    }
                }
            }
        }

        stage('Build and Push Images') {
            steps {
                script {
                    def services = [
                        'adservice',
                        'cartservice',
                        'checkoutservice',
                        'currencyservice',
                        'emailservice',
                        'frontend',
                        'loadgenerator',
                        'paymentservice',
                        'productcatalogservice',
                        'recommendationservice',
                        'shippingservice'
                    ]

                    services.each { service ->

                        echo "Building ${service}"

                        def dockerfile = "./src/${service}/Dockerfile"
                        def context = "./src/${service}"

                        // Cartservice has a nested Dockerfile
                        if (service == 'cartservice') {
                            dockerfile = './src/cartservice/src/Dockerfile'
                            context = './src/cartservice/src'
                        }

                        sh """
                            docker build \
                              -f ${dockerfile} \
                              -t ${ECR_REGISTRY}/${ECR_PREFIX}/${service}:${IMAGE_TAG} \
                              -t ${ECR_REGISTRY}/${ECR_PREFIX}/${service}:latest \
                              ${context}

                            docker push \
                              ${ECR_REGISTRY}/${ECR_PREFIX}/${service}:${IMAGE_TAG}

                            docker push \
                              ${ECR_REGISTRY}/${ECR_PREFIX}/${service}:latest
                        """
                    }
                }
            }
        }

        stage('Update Helm Values') {
            steps {
                sh '''
                    python3 - <<'PY'
import os
import re
from pathlib import Path

services = [
    "adservice",
    "cartservice",
    "checkoutservice",
    "currencyservice",
    "emailservice",
    "frontend",
    "loadgenerator",
    "paymentservice",
    "productcatalogservice",
    "recommendationservice",
    "shippingservice"
]

registry = os.environ["ECR_REGISTRY"]
prefix = os.environ["ECR_PREFIX"]
tag = os.environ["IMAGE_TAG"]

path = Path(os.environ["HELM_VALUES"])
content = path.read_text()

for service in services:

    pattern = re.compile(
        rf"(?ms)(^  {re.escape(service)}:\\n)(.*?)(?=^  [A-Za-z][A-Za-z0-9]*:\\n|^serviceAccounts:)"
    )

    match = pattern.search(content)

    if not match:
        raise RuntimeError(
            f"Could not find images.{service} in {path}"
        )

    block = match.group(2)

    repository = f"{registry}/{prefix}/{service}"

    block, repo_count = re.subn(
        r"(?m)^    repository:.*$",
        f"    repository: {repository}",
        block,
        count=1
    )

    block, tag_count = re.subn(
        r"(?m)^    tag:.*$",
        f"    tag: {tag}",
        block,
        count=1
    )

    if repo_count != 1 or tag_count != 1:
        raise RuntimeError(
            f"Could not update repository/tag for {service}"
        )

    content = (
        content[:match.start(2)]
        + block
        + content[match.end(2):]
    )

path.write_text(content)

print("Updated Helm image repositories and tags successfully.")
PY

                    echo "Updated Helm values:"
                    grep -A3 -E '^  (adservice|cartservice|checkoutservice|currencyservice|emailservice|frontend|loadgenerator|paymentservice|productcatalogservice|recommendationservice|shippingservice):' "$HELM_VALUES"
                '''
            }
        }

        stage('Push GitOps Changes') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-gitops',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x

                        git config user.name "Jenkins"
                        git config user.email "jenkins@localhost"

                        git add "$HELM_VALUES"

                        if git diff --cached --quiet; then
                            echo "No Helm changes to commit."
                        else
                            git commit -m "Update Online Boutique images to ${IMAGE_TAG}"

                            cat > .git-askpass.sh <<'EOF'
#!/bin/sh
case "$1" in
    *Username*) printf '%s\\n' "$GIT_USERNAME" ;;
    *Password*) printf '%s\\n' "$GIT_PASSWORD" ;;
esac
EOF

                            chmod 700 .git-askpass.sh
                            trap 'rm -f .git-askpass.sh' EXIT

                            git fetch origin main
                            git rebase origin/main

                            GIT_ASKPASS="$PWD/.git-askpass.sh" \
                            GIT_TERMINAL_PROMPT=0 \
                            git push origin HEAD:main
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            sh '''
                docker logout "$ECR_REGISTRY" || true
            '''
        }

        success {
            echo 'Online Boutique CI pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the failed stage in Console Output.'
        }
    }
}
